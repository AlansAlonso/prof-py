# Copie este arquivo para .env e preencha com sua chave da OpenAI
OPENAI_API_KEY=sk-...sua-chave-aqui...

# ── Langfuse (OPCIONAL) ──
# Se estas variáveis não estiverem definidas, o Modo agente funciona normalmente, só sem traces.
# Chaves em https://cloud.langfuse.com (ou na sua instância própria)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
